{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dante-labs.com/contracts/market-snapshot.schema.json",
  "title": "MarketSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "schema_version", "as_of", "available_at", "source", "symbol", "currency", "rows", "warnings"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "const": "MarketSnapshot" },
    "schema_version": { "const": "1.0.0" },
    "as_of": { "type": "string", "format": "date-time" },
    "available_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "pattern": "^[0-9]{6}$" },
    "name": { "type": "string", "minLength": 1 },
    "currency": { "const": "KRW" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trade_date", "open_price", "high_price", "low_price", "close_price", "volume", "adjusted", "is_final"],
        "properties": {
          "trade_date": { "type": "string", "format": "date" },
          "open_price": { "type": "integer", "minimum": 0 },
          "high_price": { "type": "integer", "minimum": 0 },
          "low_price": { "type": "integer", "minimum": 0 },
          "close_price": { "type": "integer", "minimum": 0 },
          "volume": { "type": ["integer", "null"], "minimum": 0 },
          "adjusted": { "type": "boolean" },
          "is_final": { "const": true }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
