# ─────────────────────────────────────────────────────────────
# 키움증권 REST API — 반드시 "모의투자용" 키를 넣으세요
#   발급: openapi.kiwoom.com 로그인 → API 사용신청 → 환경: 모의투자
#   ⚠️ 상시모의투자 참가신청을 먼저 해야 모의용 키가 나옵니다
#   ⚠️ 실전 키와 다릅니다. 실전 키를 여기 넣지 마세요
# ─────────────────────────────────────────────────────────────
KIWOOM_REST_API_KEY=
KIWOOM_REST_API_SECRET=
KIWOOM_API_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_ENV=MOCK

# ─────────────────────────────────────────────────────────────
# 토스증권 Open API — 선택. 발급이 아직 안 열렸다면 비워 두세요
#   (토스 없이도 실습은 키움만으로 완주됩니다)
#   발급: 토스증권 WTS(PC 웹) → 설정 → Open API · 허용 IP 등록 필요
# ─────────────────────────────────────────────────────────────
TOSS_OPENAPI_KEY=
TOSS_OPENAPI_SECRET_KEY=
